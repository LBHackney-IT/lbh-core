<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Targeting">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup Label="Compilation">
    <!--
      CA1303, CA1305 and CA1307 are globalization warnings that do not apply to these tests.
      CA1001 and CA1062 are not enforced on test fixtures.
    -->
    <NoWarn>CA1303;CA1305;CA1001;CA1062;CA1307</NoWarn>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Label="Test File Excludes">
    <Compile Remove="TestResults\**" />
    <EmbeddedResource Remove="TestResults\**" />
    <None Remove="TestResults\**" />
  </ItemGroup>

  <ItemGroup Label="Test Dependencies">
    <PackageReference Include="AutoFixture" Version="4.18.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.1" />
    <PackageReference Include="coverlet.msbuild" Version="10.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup Label="Project References">
    <ProjectReference Include="..\..\Hackney.Core\Hackney.Core.Sns\Hackney.Core.Sns.csproj" />
    <ProjectReference Include="..\..\Hackney.Core\Hackney.Core.Testing\Hackney.Core.Testing.Shared\Hackney.Core.Testing.Shared.csproj" />
  </ItemGroup>

</Project>
