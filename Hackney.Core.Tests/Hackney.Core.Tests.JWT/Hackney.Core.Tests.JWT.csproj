<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Targeting">
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup Label="Compilation">
    <Nullable>enable</Nullable>
    <!--
      CA1707 suppresses the warnings about undescores within test names
      CA1873 false positive on logger assertion: Evaluation of this argument may be expensive and unnecessary if logging is disabled
    -->
    <NoWarn>CA1707;CA1873</NoWarn>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Label="TestFileExcludes">
    <Compile Remove="TestResults\**" />
    <EmbeddedResource Remove="TestResults\**" />
    <None Remove="TestResults\**" />
  </ItemGroup>

  <ItemGroup Label="Test Dependencies">
    <PackageReference Include="AutoFixture" Version="4.18.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="coverlet.msbuild" Version="10.1.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup Label="Project References">
    <ProjectReference Include="..\..\Hackney.Core\Hackney.Core.JWT\Hackney.Core.JWT.csproj" />
    <ProjectReference Include="..\..\Hackney.Core\Hackney.Core.Testing\Hackney.Core.Testing.Shared\Hackney.Core.Testing.Shared.csproj" />
  </ItemGroup>

</Project>
